{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weighin.dev/schemas/measurement-records.schema.json",
  "title": "WeighIn Saved Measurement Records",
  "description": "Authoritative versioned schema for WeighIn saved measurement record arrays across legacy unversioned, schema_version 2, schema_version 3, and schema_version 4 envelopes.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/ContractBenchmark"
  },
  "x-weighin-current-version": 4,
  "x-weighin-supported-versions": [
    "legacy",
    2,
    3,
    4
  ],
  "x-weighin-runtime-invariants": [
    {
      "id": "UNIQUE_CONTRACT_IDENTITY",
      "scope": "record_set",
      "description": "Within a saved measurement array, no two ContractBenchmark entries may share the same comparison key ([\"legacy\", contract_id] for legacy records or [\"logical\", fixture_id, logical_id] for schema 2/3/4 records)."
    },
    {
      "id": "UNIQUE_BENCHMARK_IDENTITY",
      "scope": "contract_record",
      "description": "Within a ContractBenchmark.benchmarks array, no two BenchmarkResult entries may share the same [function_name, case_id ?? null] identity."
    },
    {
      "id": "HOMOGENEOUS_ENVELOPE_VERSION",
      "scope": "record_set",
      "description": "All ContractBenchmark entries within a single saved measurement array must use the same envelope version (legacy, 2, 3, or 4)."
    },
    {
      "id": "COMPARISON_ENVIRONMENT_COMPATIBILITY",
      "scope": "comparison",
      "description": "When comparing BASE and HEAD measurement sets, versioned schemas must match, and paired benchmarks with provenance must have identical source, source_version, protocol, helper_sha256, network_id, compute_config_sha256, seed, auth_mode, host_features, resource_limits_sha256, source_account, and schema-4 per-metric availability/source/limit/limit_source/limit_reason."
    },
    {
      "id": "SAFE_INTEGER_BOUNDS",
      "scope": "value",
      "description": "Numeric consumption, limit, timestamp, ledger, and protocol values must satisfy Number.isSafeInteger in JavaScript runtime validation."
    }
  ],
  "$defs": {
    "NonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "SafeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "SafePositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "NullableSafeNonNegativeInteger": {
      "oneOf": [
        {
          "$ref": "#/$defs/SafeNonNegativeInteger"
        },
        {
          "type": "null"
        }
      ]
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "AccountPublicKey": {
      "type": "string",
      "pattern": "^G[A-Z2-7]{55}$"
    },
    "SeedByte": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "SeedArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SeedByte"
      },
      "minItems": 32,
      "maxItems": 32
    },
    "LegacyOrSchema2MetricValue": {
      "oneOf": [
        {
          "title": "MeasuredMetricValue",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consumed",
            "limit"
          ],
          "properties": {
            "availability": {
              "const": "measured"
            },
            "consumed": {
              "$ref": "#/$defs/SafeNonNegativeInteger"
            },
            "limit": {
