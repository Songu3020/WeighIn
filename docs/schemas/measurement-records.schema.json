{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weighin.dev/schemas/measurement-records.schema.json",
  "title": "WeighIn Saved Measurement Records",
  "description": "Authoritative versioned schema for WeighIn saved measurement record arrays across legacy unversioned, schema_version 2, schema_version 3, schema_version 4, and schema_version 5 envelopes.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/ContractBenchmark"
  },
  "x-weighin-current-version": 5,
  "x-weighin-supported-versions": [
    "legacy",
    2,
    3,
    4,
    5
  ],
  "x-weighin-runtime-invariants": [
    {
      "id": "UNIQUE_CONTRACT_IDENTITY",
      "scope": "record_set",
      "description": "Within a saved measurement array, no two ContractBenchmark entries may share the same comparison key ([\"legacy\", contract_id] for legacy records or [\"logical\", fixture_id, logical_id] for schema 2/3/4/5 records)."
    },
    {
      "id": "UNIQUE_BENCHMARK_IDENTITY",
      "scope": "contract_record",
      "description": "Within a ContractBenchmark.benchmarks array, no two BenchmarkResult entries may share the same [function_name, case_id ?? null] identity."
    },
    {
      "id": "HOMOGENEOUS_ENVELOPE_VERSION",
      "scope": "record_set",
      "description": "All ContractBenchmark entries within a single saved measurement array must use the same envelope version (legacy, 2, 3, 4, or 5)."
    },
    {
      "id": "COMPARISON_ENVIRONMENT_COMPATIBILITY",
      "scope": "comparison",
      "description": "When comparing BASE and HEAD measurement sets, versioned schemas must match, and paired benchmarks with provenance must have identical source, source_version, protocol, helper_sha256, network_id, compute_config_sha256, seed, auth_mode, host_features, resource_limits_sha256, source_account, and schema-4/5 per-metric availability/source/limit/limit_source/limit_reason. Schema 5 additionally requires each metric's source and limit provenance to match its approved mapping."
    },
    {
      "id": "SAFE_INTEGER_BOUNDS",
      "scope": "value",
      "description": "Numeric consumption, limit, timestamp, ledger, and protocol values must satisfy Number.isSafeInteger in JavaScript runtime validation."
    }
  ],
  "$defs": {
    "NonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "SafeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "SafePositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "NullableSafeNonNegativeInteger": {
      "oneOf": [
        {
          "$ref": "#/$defs/SafeNonNegativeInteger"
        },
        {
          "type": "null"
        }
      ]
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "AccountPublicKey": {
      "type": "string",
      "pattern": "^G[A-Z2-7]{55}$"
    },
    "SeedByte": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "SeedArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SeedByte"
      },
      "minItems": 32,
      "maxItems": 32
    },
    "LegacyOrSchema2MetricValue": {
      "oneOf": [
        {
          "title": "MeasuredMetricValue",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consumed",
            "limit"
          ],
          "properties": {
            "availability": {
              "const": "measured"
            },
            "consumed": {
              "$ref": "#/$defs/SafeNonNegativeInteger"
            },
            "limit": {
              "$ref": "#/$defs/NullableSafeNonNegativeInteger"
            },
            "reason": {
              "$ref": "#/$defs/NonBlankString"
            },
            "source": {
              "$ref": "#/$defs/NonBlankString"
            },
            "limit_source": {
              "$ref": "#/$defs/NonBlankString"
            },
            "limit_reason": {
              "$ref": "#/$defs/NonBlankString"
            }
          }
        },
        {
          "title": "UnavailableMetricValue",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "consumed",
            "limit",
            "reason"
          ],
          "properties": {
            "availability": {
              "const": "unavailable"
            },
            "consumed": {
              "type": "null"
            },
            "limit": {
              "$ref": "#/$defs/NullableSafeNonNegativeInteger"
            },
            "reason": {
              "$ref": "#/$defs/NonBlankString"
            },
            "source": {
              "$ref": "#/$defs/NonBlankString"
            },
            "limit_source": {
              "$ref": "#/$defs/NonBlankString"
            },
            "limit_reason": {
              "$ref": "#/$defs/NonBlankString"
            }
          }
        }
      ]
    },
    "Schema3MetricValue": {
      "oneOf": [
        {
          "title": "Schema3MeasuredMetricValue",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "consumed",
            "limit",
            "source"
          ],
          "properties": {
            "availability": {
              "const": "measured"
            },
            "consumed": {
              "$ref": "#/$defs/SafeNonNegativeInteger"
            },
            "limit": {
              "$ref": "#/$defs/NullableSafeNonNegativeInteger"
            },
            "source": {
              "$ref": "#/$defs/NonBlankString"
            },
            "reason": {
              "$ref": "#/$defs/NonBlankString"
            },
            "limit_source": {
              "$ref": "#/$defs/NonBlankString"
            },
            "limit_reason": {
              "$ref": "#/$defs/NonBlankString"
            }
          }
        },
        {
          "title": "Schema3UnavailableMetricValue",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "consumed",
            "limit",
            "reason"
          ],
          "properties": {
            "availability": {
              "const": "unavailable"
            },
            "consumed": {
              "type": "null"
            },
            "limit": {
              "$ref": "#/$defs/NullableSafeNonNegativeInteger"
            },
            "reason": {
              "$ref": "#/$defs/NonBlankString"
            },
            "source": {
              "$ref": "#/$defs/NonBlankString"
            },
            "limit_source": {
              "$ref": "#/$defs/NonBlankString"
            },
            "limit_reason": {
              "$ref": "#/$defs/NonBlankString"
            }
          }
        }
      ]
    },
    "Schema4MetricValue": {
      "oneOf": [
        {
          "title": "Schema4MeasuredBoundedMetricValue",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "consumed",
            "limit",
            "source",
            "limit_source"
          ],
          "properties": {
            "availability": {
              "const": "measured"
            },
            "consumed": {
              "$ref": "#/$defs/SafeNonNegativeInteger"
            },
            "limit": {
              "$ref": "#/$defs/SafeNonNegativeInteger"
            },
            "source": {
              "$ref": "#/$defs/NonBlankString"
            },
            "limit_source": {
              "$ref": "#/$defs/NonBlankString"
            },
            "limit_reason": {
              "$ref": "#/$defs/NonBlankString"
            },
            "reason": {
              "$ref": "#/$defs/NonBlankString"
            }
          }
        },
        {
          "title": "Schema4MeasuredUnboundedMetricValue",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "consumed",
            "limit",
            "source",
            "limit_reason"
          ],
          "properties": {
            "availability": {
              "const": "measured"
            },
            "consumed": {
              "$ref": "#/$defs/SafeNonNegativeInteger"
            },
            "limit": {
              "type": "null"
            },
            "source": {
              "$ref": "#/$defs/NonBlankString"
            },
            "limit_reason": {
              "$ref": "#/$defs/NonBlankString"
            },
            "limit_source": {
              "$ref": "#/$defs/NonBlankString"
            },
            "reason": {
              "$ref": "#/$defs/NonBlankString"
            }
          }
        },
        {
          "title": "Schema4UnavailableMetricValue",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "consumed",
            "limit",
            "reason"
          ],
          "properties": {
            "availability": {
              "const": "unavailable"
            },
            "consumed": {
              "type": "null"
            },
            "limit": {
              "$ref": "#/$defs/NullableSafeNonNegativeInteger"
            },
            "reason": {
              "$ref": "#/$defs/NonBlankString"
            },
            "source": {
              "$ref": "#/$defs/NonBlankString"
            },
            "limit_source": {
              "$ref": "#/$defs/NonBlankString"
            },
            "limit_reason": {
              "$ref": "#/$defs/NonBlankString"
            }
          }
        }
      ]
    },
    "LegacyOrSchema2Metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_instructions",
        "memory_bytes",
        "ledger_read_entries",
        "ledger_read_bytes",
        "ledger_write_entries",
        "ledger_write_bytes",
        "historical_data_read_bytes",
        "contract_data_hard_limit",
        "tx_size_bytes",
        "events_count",
        "event_data_bytes"
      ],
      "properties": {
        "cpu_instructions": {
          "$ref": "#/$defs/LegacyOrSchema2MetricValue"
        },
        "memory_bytes": {
          "$ref": "#/$defs/LegacyOrSchema2MetricValue"
        },
        "ledger_read_entries": {
          "$ref": "#/$defs/LegacyOrSchema2MetricValue"
        },
        "ledger_read_bytes": {
          "$ref": "#/$defs/LegacyOrSchema2MetricValue"
        },
        "ledger_write_entries": {
          "$ref": "#/$defs/LegacyOrSchema2MetricValue"
        },